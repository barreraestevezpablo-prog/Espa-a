
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Notificar incidencia</title>
</head>
<body>

<h1>Notificar una incidencia</h1>

<form action="procesar-incidencia.php" method="post">

    <fieldset>
        <legend>Datos del usuario</legend>

        <label for="usuario">Usuario:</label>
        <input type="text" id="usuario" name="usuario" value="Anastacia">
        <br><br>

        <label for="departamento">Departamento:</label>
        <select id="departamento" name="departamento">
            <option>Informática</option>
            <option selected>Marketing</option>
            <option>Ventas</option>
        </select>
        <br><br>

        <label for="descripcion">Descripción de la incidencia:</label>
        <br>
        <textarea id="descripcion" name="descripcion" rows="3" cols="40">El tóner de color amarillo está vacío.</textarea>
    </fieldset>

    <br>

    <fieldset>
        <legend>Enviar formulario</legend>

        <input type="reset" value="Borrar">
        <input type="submit" value="Enviar">
    </fieldset>

</form>

</body>
</html>
